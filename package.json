{
  "name": "modern-quality-engineering-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Production-style SDET showcase: risk-based test layers (unit, API, contract, integration, E2E, accessibility, performance, AI evals) around a small TypeScript service, with Playwright Agents/MCP, Testcontainers, Pact, Promptfoo, OpenTelemetry and k6.",
  "keywords": [
    "sdet",
    "quality-engineering",
    "test-automation",
    "playwright",
    "pact",
    "contract-testing",
    "testcontainers",
    "accessibility",
    "axe-core",
    "k6",
    "promptfoo",
    "opentelemetry",
    "typescript"
  ],
  "author": "Özgür Çetintaş (https://github.com/cozgur)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cozgur/modern-quality-engineering-lab.git"
  },
  "homepage": "https://lab.ozgurcetintas.dev/",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:otel": "node --import tsx --import ./src/instrumentation.ts src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run test:api",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:coverage": "vitest run tests/unit tests/api --coverage",
    "test:mutation": "stryker run",
    "test:integration": "vitest run tests/integration",
    "test:contract:consumer": "vitest run tests/contract/user.consumer.pact.test.ts",
    "test:contract:provider": "vitest run tests/contract/user.provider.pact.test.ts",
    "test:contract": "npm run test:contract:consumer && npm run test:contract:provider",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility",
    "test:perf:api": "k6 run tests/performance/api-load.js",
    "test:perf:browser": "k6 run tests/performance/browser.js",
    "agents:codex": "playwright init-agents --loop=codex",
    "agents:claude": "playwright init-agents --loop=claude",
    "agents:vscode": "playwright init-agents --loop=vscode",
    "mcp": "npx --yes @playwright/mcp@0.0.80",
    "eval:ai": "npx --yes promptfoo@0.123.0 eval -c promptfoo/promptfooconfig.yaml"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "express": "5.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
